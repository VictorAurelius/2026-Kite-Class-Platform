# Monorepo Root .gitignore

# CI/CD Logs (all projects)
.log/*.txt
.log/*.log
.log/*.dump
.log/*.dumpstream
.log/auto/
.log/temp/
.log/run-*/
*/.log/

# But keep scripts
!.log/check-ci.sh
!.log/README.md

# Claude Code local settings (never commit)
.claude/settings.local.json

# Docker build logs (local only, different per machine)
.docker-build-logs/
*/.docker-build-logs/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db
