# Monorepo Root .gitignore

# CI/CD Logs
infrastructure/logs/*.txt
infrastructure/logs/*.log
infrastructure/logs/*.dump
infrastructure/logs/*.json
infrastructure/logs/auto/
infrastructure/logs/temp/
infrastructure/logs/run-*/
*/.log/

# But keep scripts in logs
!infrastructure/logs/check-ci.sh
!infrastructure/logs/README.md

# Claude Code local settings (never commit)
.claude/settings.local.json

# Environment files (contain secrets - never commit)
.env
.env.local
.env.*.local
!.env.example
!.env.docker.example

# Encryption keys
*.key
*.pem

# Terraform
infrastructure/terraform-aws/.terraform/
infrastructure/terraform-aws/*.tfstate
infrastructure/terraform-aws/*.tfstate.backup
infrastructure/terraform-aws/*.tfvars
!infrastructure/terraform-aws/*.tfvars.example
infrastructure/terraform-aws/.terraform.lock.hcl
infrastructure/terraform-oracle/.terraform/
infrastructure/terraform-oracle/*.tfstate
infrastructure/terraform-oracle/*.tfstate.backup
infrastructure/terraform-oracle/*.tfvars
!infrastructure/terraform-oracle/*.tfvars.example
infrastructure/terraform-oracle/.terraform.lock.hcl

# Root node_modules (not a monorepo package)
/node_modules/

# Docker build logs (local only, different per machine)
.docker-build-logs/
*/.docker-build-logs/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Maven build artifacts
**/target/
target/
**/target/**
*.class
*.jar
*.war
*.ear
