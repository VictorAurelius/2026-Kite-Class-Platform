# Monorepo Root .gitignore

# CI/CD Logs (all projects)
.log/*.txt
.log/*.log
.log/*.dump
.log/*.dumpstream
.log/auto/
.log/temp/
.log/run-*/
*/.log/

# But keep scripts
!.log/check-ci.sh
!.log/README.md

# Claude Code local settings (never commit)
.claude/settings.local.json

# Environment files (contain secrets - never commit)
.env
.env.local
.env.*.local
!.env.example
!.env.docker.example

# Encryption keys
*.key
*.pem

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/.terraform.lock.hcl

# Docker build logs (local only, different per machine)
.docker-build-logs/
*/.docker-build-logs/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Maven build artifacts
**/target/
target/
**/target/**
*.class
*.jar
*.war
*.ear
