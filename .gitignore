# Monorepo Root .gitignore

# CI/CD Logs
infrastructure/logs/*.txt
infrastructure/logs/*.log
infrastructure/logs/*.dump
infrastructure/logs/*.json
infrastructure/logs/auto/
infrastructure/logs/temp/
infrastructure/logs/run-*/
*/.log/
.log/

# But keep scripts in logs
!infrastructure/logs/check-ci.sh
!infrastructure/logs/README.md

# Claude Code local settings (never commit)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Session locks (per-machine, GAP-193) — keep README + .gitkeep only
.claude/session-locks/*.lock
.claude/session-locks/archived/
.claude/skills/workflow/start-session/data/*.log

# Worktree clones spawned by parallel agents (transient per-machine state)
.claude/worktrees/

# AWS Phase 1 BETA snapshot cache (start-session skill, 30m TTL, per-machine)
# Tier 1 read-only data only; no secret material per agent-aws-access.md §2.2
.claude/session-aws-cache/

# AWS stack on-demand session ledger (scripts/aws/start-stack.sh + stop-stack.sh, Wave 61 Bucket D)
# Local per-operator usage log; informs cost forecast but no shared state required
.aws-stack-state.json

# Environment files (contain secrets - never commit)
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.test
!.env.example
!.env.docker.example
!.env.production.template
!.env.test.example

# Encryption keys
*.key
*.pem

# Terraform
infrastructure/terraform-aws/.terraform/
infrastructure/terraform-aws/*.tfstate
infrastructure/terraform-aws/*.tfstate.backup
infrastructure/terraform-aws/*.tfvars
!infrastructure/terraform-aws/*.tfvars.example
# Backend partial config — contains AWS account ID via bucket name (public-repo-safe pattern)
infrastructure/terraform-aws/backend.config
!infrastructure/terraform-aws/backend.config.example
# .terraform.lock.hcl should be committed (pins provider versions like package-lock.json)
infrastructure/terraform-aws/bootstrap/.terraform/
infrastructure/terraform-aws/bootstrap/*.tfstate
infrastructure/terraform-aws/bootstrap/*.tfstate.backup
infrastructure/terraform-oracle/.terraform/
infrastructure/terraform-oracle/*.tfstate
infrastructure/terraform-oracle/*.tfstate.backup
infrastructure/terraform-oracle/*.tfvars
!infrastructure/terraform-oracle/*.tfvars.example
# backend.hcl contains OCI credentials — never commit
infrastructure/terraform-oracle/backend.hcl

# Root node_modules (workspace root install location per ADR-024)
/node_modules/

# Workspace package node_modules (packages/* is pnpm workspace per ADR-024)
/packages/*/node_modules/

# Docker build logs (local only, different per machine)
.docker-build-logs/
*/.docker-build-logs/

# UI screenshots — PNGs are local only (large binary), but manifest.md IS committed
# manifest.md = auto-generated index per capture run, useful for audit history
documents/screenshots/**/*.png

# User manual PDFs — regen-on-demand per scripts/render-user-manual-pdf.sh
# Source-of-truth = Markdown in documents/05-guides/user-manual/{persona}/*.md
# Per `.claude/rules/user-manual-content-standard.md` §2 item 15 + test-artifact-format-standard.md §4.2
documents/05-guides/user-manual/*-manual.pdf
documents/05-guides/user-manual/**/*-manual.pdf

# Python cache
__pycache__/
*.pyc

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Maven build artifacts
**/target/
target/
**/target/**
*.class
*.jar
*.war
*.ear

# kiteclass/shared/ — CI-generated OpenAPI export (regenerated per PR)
kiteclass/shared/openapi.json
kiteclass/shared/openapi.json.tmp

# Skill runtime data (append-only logs, regenerated per skill run)
.claude/skills/quality/ui-review-prototype/data/runs.log

# TypeScript incremental build info
**/tsconfig.tsbuildinfo
documents/image*.png

# Per-workspace pnpm lock duplicates — root pnpm-lock.yaml is canonical (workspace mode)
# Wave 64: deleted to resolve 26 stale Dependabot alerts (next 15.5.15 → 15.5.18)
kitehub/kitehub-frontend/pnpm-lock.yaml
kiteclass/kiteclass-frontend/pnpm-lock.yaml

# Wave 75 Bucket E — coverage.py data files / HTML / XML artifacts (.coveragerc kept in repo)
.coverage
.coverage.*
.claude/hooks/tests/coverage-html/
.claude/hooks/tests/coverage.xml

# Hook runtime state (per-machine timestamp markers, regenerated per hook fire).
# Folder-wide ignore + allowlist for tracked config files (e.g. keyword-rule-map.json).
.claude/hooks/data/*
!.claude/hooks/data/keyword-rule-map.json
.vercel/

# Wave 102 GAP-688 thesis V1 Python pipeline (local venv + build artifacts)
documents/08-thesis/.venv/
documents/08-thesis/__pycache__/
documents/08-thesis/*.pyc

# Wave 102.2 — Mermaid PNG cache (regenerated via kroki.io)
documents/08-thesis/.mermaid-cache/

# Demo-trio walk evidence screenshots — local-only (regen via e2e/capture-thesis-evidence.mjs)
documents/08-thesis/evidence/

# Demo landing image assets — local-only, never commit binaries to remote (per user rule).
# Seed sets URL strings (committed code); the binary asset bytes stay local.
kiteclass/kiteclass-frontend/public/demo/
documents/asset.png
documents/sky-banner-draft.png
