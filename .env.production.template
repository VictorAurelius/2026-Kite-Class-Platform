# =============================================================================
# .env.production.template — Kitehub Platform production env vars
# =============================================================================
#
# COPY this file to `.env.production` (gitignored) and fill in real values
# OR pull values from AWS Secrets Manager via:
#   aws secretsmanager get-secret-value --secret-id kitehub/production/<key>
#
# Markers:
#   [REQUIRED]   — service WILL FAIL TO START without this
#   [USER_INPUT] — user must fill specific value (e.g., domain, account ID)
#   [SECRETS]    — value from AWS Secrets Manager (DO NOT commit real value)
#   [OPTIONAL]   — has sensible default; override only if needed
#
# Standards: Twelve-Factor App config-in-env · `.claude/rules/release-deploy-standard.md` §3.1
# Sister docs: documents/05-guides/operations/secrets-management-runbook.md
# =============================================================================


# -----------------------------------------------------------------------------
# Common — applies to all services
# -----------------------------------------------------------------------------
# [REQUIRED] Spring profile selector
SPRING_PROFILES_ACTIVE=production

# [REQUIRED] Deployment environment label (used in logs + metrics tags)
KITE_ENV=production

# [USER_INPUT] AWS region (currently ap-southeast-1 / Singapore for VN data localization)
AWS_REGION=ap-southeast-1

# [USER_INPUT] AWS account ID (12 digits, no dashes)
AWS_ACCOUNT_ID=000000000000

# [REQUIRED] Public origin URL — used for OAuth redirect URLs, email links, CORS
KITE_PUBLIC_BASE_URL=https://beta.kitehub.vn

# [REQUIRED] Cookie domain for SSO across subdomains
KITE_COOKIE_DOMAIN=.kitehub.vn

# [OPTIONAL] Default timezone (used for invoice generation, scheduled jobs)
TZ=Asia/Ho_Chi_Minh


# -----------------------------------------------------------------------------
# Database — PostgreSQL (RDS or self-hosted)
# -----------------------------------------------------------------------------
# [USER_INPUT] DB endpoint (RDS hostname or VM IP)
KITE_DB_HOST=kitehub-prod.xxxxxx.ap-southeast-1.rds.amazonaws.com

# [OPTIONAL] DB port (5432 default)
KITE_DB_PORT=5432

# [REQUIRED] DB name (use 1 instance per environment)
KITE_DB_NAME=kitehub_production

# [REQUIRED] DB user (least-privilege; NOT master)
KITE_DB_USER=kitehub_app

# [SECRETS] DB password — AWS Secrets Manager: kitehub/production/db-password
KITE_DB_PASSWORD=

# [OPTIONAL] HikariCP pool sizing (per service, tune based on load test)
KITE_DB_POOL_MAX=20
KITE_DB_POOL_MIN_IDLE=5
KITE_DB_POOL_CONNECTION_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# Redis — ElastiCache or self-hosted
# -----------------------------------------------------------------------------
# [USER_INPUT] Redis endpoint
KITE_REDIS_HOST=kitehub-prod-redis.xxxxxx.ng.0001.apse1.cache.amazonaws.com

# [OPTIONAL] Redis port
KITE_REDIS_PORT=6379

# [SECRETS] Redis AUTH token — AWS Secrets Manager: kitehub/production/redis-auth-token
KITE_REDIS_PASSWORD=

# [OPTIONAL] Redis DB index (0-15)
KITE_REDIS_DB=0


# -----------------------------------------------------------------------------
# RabbitMQ — message broker
# -----------------------------------------------------------------------------
# [USER_INPUT] RabbitMQ host
KITE_RABBITMQ_HOST=kitehub-prod-mq.internal

# [OPTIONAL] AMQP port
KITE_RABBITMQ_PORT=5672

# [REQUIRED] RabbitMQ user
KITE_RABBITMQ_USER=kitehub

# [SECRETS] RabbitMQ password — AWS Secrets Manager: kitehub/production/rabbitmq-password
KITE_RABBITMQ_PASSWORD=

# [REQUIRED] vhost (use per-environment vhost)
KITE_RABBITMQ_VHOST=/kitehub-production


# -----------------------------------------------------------------------------
# MinIO / S3 — object storage
# -----------------------------------------------------------------------------
# [USER_INPUT] S3 endpoint (use AWS S3 in production; MinIO only for dev/staging)
KITE_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com

# [REQUIRED] S3 bucket name
KITE_S3_BUCKET=kitehub-production-assets

# [REQUIRED] S3 region (must match `AWS_REGION` typically)
KITE_S3_REGION=ap-southeast-1

# [OPTIONAL] AWS auth — prefer EKS workload identity / EC2 instance profile
# Only set these if running outside AWS (Oracle Cloud Phase 1 BETA):
KITE_AWS_ACCESS_KEY_ID=
KITE_AWS_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# JWT / Authentication
# -----------------------------------------------------------------------------
# [SECRETS] JWT signing secret — AWS Secrets Manager: kitehub/production/jwt-secret
# Min 64 chars; rotate every 180 days with versioned `kid` claim.
KITE_JWT_SECRET=

# [OPTIONAL] JWT issuer (used in `iss` claim + validation)
KITE_JWT_ISSUER=https://kitehub.vn

# [OPTIONAL] Access token TTL (15 min default)
KITE_JWT_ACCESS_TTL_SECONDS=900

# [OPTIONAL] Refresh token TTL (7 days default)
KITE_JWT_REFRESH_TTL_SECONDS=604800


# -----------------------------------------------------------------------------
# Encryption (PII fields at-rest)
# -----------------------------------------------------------------------------
# [SECRETS] Master encryption key — AWS Secrets Manager: kitehub/production/encryption-key
# Base64-encoded 256-bit key. Rotation = re-encrypt PII (annual cadence).
KITE_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Email — AWS SES (per GAP-370)
# -----------------------------------------------------------------------------
# [USER_INPUT] SES SMTP endpoint
KITE_SES_SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com

# [OPTIONAL] SES SMTP port (587 STARTTLS preferred)
KITE_SES_SMTP_PORT=587

# [SECRETS] SES SMTP username — AWS Secrets Manager: kitehub/production/ses-smtp-credentials (smtp_username)
KITE_SES_SMTP_USERNAME=

# [SECRETS] SES SMTP password — AWS Secrets Manager: kitehub/production/ses-smtp-credentials (smtp_password)
KITE_SES_SMTP_PASSWORD=

# [REQUIRED] From-address (must match SES verified sender)
KITE_SES_FROM=noreply@kitehub.vn

# [REQUIRED] Reply-to address (user-replyable)
KITE_SES_REPLY_TO=support@kitehub.vn


# -----------------------------------------------------------------------------
# Cloudflare (per GAP-371)
# -----------------------------------------------------------------------------
# [SECRETS] Cloudflare API token (cache purge + WAF)
# AWS Secrets Manager: kitehub/production/cloudflare-api-token
KITE_CLOUDFLARE_API_TOKEN=

# [USER_INPUT] Cloudflare zone ID (per domain — get from Cloudflare dashboard)
KITE_CLOUDFLARE_ZONE_ID_KITEHUB=
KITE_CLOUDFLARE_ZONE_ID_KITECLASS=


# -----------------------------------------------------------------------------
# AI Branding — Ollama / OpenAI (per .claude/rules/ai-branding-guidelines.md)
# -----------------------------------------------------------------------------
# [REQUIRED] AI provider strategy: ollama | openai | mock
KITE_AI_PROVIDER=ollama

# [USER_INPUT] Ollama endpoint (self-hosted on Oracle VM 24GB)
KITE_OLLAMA_BASE_URL=http://kitehub-ollama.internal:11434

# [SECRETS] OpenAI API key (FALLBACK only) — AWS Secrets Manager: kitehub/production/openai-api-key
KITE_OPENAI_API_KEY=

# [OPTIONAL] AI input cap config (per ai-branding-guidelines §2.5)
# Tier-aware caps; -1 = unlimited (Enterprise opt-in)
KITE_AI_INPUT_CAP_FREE=2000
KITE_AI_INPUT_CAP_BASIC=4000
KITE_AI_INPUT_CAP_PREMIUM=8000
KITE_AI_INPUT_CAP_ENTERPRISE=16000


# -----------------------------------------------------------------------------
# Observability (per GAP-115)
# -----------------------------------------------------------------------------
# [OPTIONAL] Log level (INFO production default; DEBUG only for incident debug)
KITE_LOG_LEVEL=INFO

# [SECRETS] Sentry DSN — AWS Secrets Manager: kitehub/production/sentry-dsn
KITE_SENTRY_DSN=

# [OPTIONAL] Sentry environment label
KITE_SENTRY_ENVIRONMENT=production

# [OPTIONAL] Sentry release tag (set by CI from git tag)
KITE_SENTRY_RELEASE=v0.9.0-beta

# [OPTIONAL] Prometheus metrics enabled
KITE_METRICS_ENABLED=true


# -----------------------------------------------------------------------------
# Frontend (Next.js — kiteclass-frontend, kitehub-frontend)
# -----------------------------------------------------------------------------
# [REQUIRED] Public API base URL (browser-side, must be public)
NEXT_PUBLIC_API_BASE_URL=https://api.beta.kitehub.vn

# [REQUIRED] Public app base URL
NEXT_PUBLIC_APP_BASE_URL=https://beta.kitehub.vn

# [REQUIRED] Pre-release disclaimer toggle (Phase 1 BETA only)
NEXT_PUBLIC_PRE_RELEASE_BANNER=true

# [SECRETS] Server-side API token for SSR fetches (if used)
# AWS Secrets Manager: kitehub/production/frontend-ssr-token
KITE_FRONTEND_SSR_TOKEN=


# -----------------------------------------------------------------------------
# Subscription / Billing (Phase 1.5 PAID)
# -----------------------------------------------------------------------------
# [SECRETS] VNPay merchant key — Phase 1.5
# AWS Secrets Manager: kitehub/production/vnpay-merchant-key
KITE_VNPAY_MERCHANT_KEY=

# [USER_INPUT] VNPay merchant ID — Phase 1.5
KITE_VNPAY_MERCHANT_ID=

# [SECRETS] MoMo partner code — Phase 1.5
# AWS Secrets Manager: kitehub/production/momo-partner-code
KITE_MOMO_PARTNER_CODE=


# -----------------------------------------------------------------------------
# Admin / seed
# -----------------------------------------------------------------------------
# [SECRETS] Initial admin password (one-time, rotate immediately post-seed per GAP-376)
# AWS Secrets Manager: kitehub/production/admin-default-password
KITE_ADMIN_DEFAULT_PASSWORD=

# [USER_INPUT] Initial admin email
KITE_ADMIN_DEFAULT_EMAIL=admin@kitehub.vn


# -----------------------------------------------------------------------------
# Feature flags (Phase 1 BETA defaults)
# -----------------------------------------------------------------------------
# [OPTIONAL] AI Branding ENABLED globally (false = template-only mode)
KITE_FEATURE_AI_BRANDING=true

# [OPTIONAL] Self-signup ENABLED (Phase 1 BETA = invite only)
KITE_FEATURE_SELF_SIGNUP=false

# [OPTIONAL] Payment integration (Phase 1 BETA = false; Phase 1.5 = true)
KITE_FEATURE_PAYMENT=false

# [OPTIONAL] Multi-tenant DB sharding (Phase 1 = false single-DB; Phase 2+ = true)
KITE_FEATURE_DB_SHARDING=false


# =============================================================================
# Verification — after filling in:
#
#   1. Spot-check no [REQUIRED] field is empty:
#      grep -E '^[A-Z_]+=$' .env.production && echo "WARN: empty REQUIRED fields"
#
#   2. Validate no real secret committed (must NEVER commit .env.production):
#      git check-ignore .env.production && echo "OK: gitignored"
#
#   3. Test load (Spring Boot):
#      docker run --env-file .env.production --rm kitehub/core:v0.9.0-beta /opt/app/healthcheck.sh
# =============================================================================
