{
  // ========== TypeScript / Next.js ==========
  // Let VS Code auto-detect TypeScript per project (works for monorepo)
  // Each frontend (kiteclass-frontend, kitehub-frontend) uses its own node_modules/typescript
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Enable Next.js plugin for better type checking
  "typescript.preferences.includePackageJsonAutoImports": "on",

  // Show errors immediately while typing
  "typescript.validate.enable": true,
  "javascript.validate.enable": true,

  // Auto-fix on save (optional but helpful)
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },

  // ========== Java / Spring Boot ==========
  "java.compile.nullAnalysis.mode": "disabled",
  "maven.view": "hierarchical",
  "spring-boot.ls.problem.application-properties.PROP_UNKNOWN_PROPERTY": "WARNING",
  // Silence "Unnecessary @Repository" hint — Spring Data repo interfaces register
  // beans + get exception-translation automatically; codebase keeps @Repository for
  // explicit consistency. (boot2 + boot3 keys both set; unknown keys are ignored.)
  // NOTE: Spring Boot version-update hint (BOOT_VERSION_VALIDATION) is intentionally
  // KEPT — it's a useful maintenance/security nudge.
  "spring-boot.ls.problem.boot2.JAVA_REPOSITORY": "IGNORE",
  "spring-boot.ls.problem.boot3.JAVA_REPOSITORY": "IGNORE",
  "java.configuration.updateBuildConfiguration": "automatic",

  // Java compiler settings - sync with Maven (Java 17)
  "java.jdt.ls.java.home": null,
  "java.errors.incompleteClasspath.severity": "ignore",

  // Resource leak warnings disabled via kiteclass-core/.settings/org.eclipse.jdt.core.prefs

  // Disable ALL markdownlint rules (simplest approach)
  "markdownlint.config": {
    "default": false  // Disable all rules globally
  },

  // Disable all diagnostics for markdown files
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {},
    "cSpell.enabled": false
  },

  // Hide markdown diagnostics from Problems panel
  "markdown.validate.enabled": false,
  "markdownlint.run": "onSave",

  // cSpell: add Vietnamese language + project words
  "cSpell.language": "en,vi",
  "cSpell.words": [
    "kiteclass",
    "kitehub",
    "vietqr",
    "qrcode"
  ],
  "cSpell.enableFiletypes": [
    "!markdown"
  ],
  "postman.settings.dotenv-detection-notification-visibility": false,
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m -Declipse.jdt.core.compiler.problem.unusedObjectAllocation=warning -Declipse.jdt.core.compiler.problem.potentialResourceLeak=warning"
}
