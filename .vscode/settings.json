{
  "java.compile.nullAnalysis.mode": "disabled",
  "maven.view": "hierarchical",
  "spring-boot.ls.problem.application-properties.PROP_UNKNOWN_PROPERTY": "WARNING",
  "java.configuration.updateBuildConfiguration": "automatic",

  // Java compiler settings - sync with Maven (Java 17)
  "java.jdt.ls.java.home": null,
  "java.errors.incompleteClasspath.severity": "ignore",

  // Resource leak warnings disabled via kiteclass-core/.settings/org.eclipse.jdt.core.prefs

  // Disable ALL markdownlint rules (simplest approach)
  "markdownlint.config": {
    "default": false  // Disable all rules globally
  },

  // Disable all diagnostics for markdown files
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {},
    "cSpell.enabled": false
  },

  // Hide markdown diagnostics from Problems panel
  "markdown.validate.enabled": false,
  "markdownlint.run": "onSave",

  // cSpell: add Vietnamese language + project words
  "cSpell.language": "en,vi",
  "cSpell.words": [
    "kiteclass",
    "kitehub",
    "vietqr"
  ],
  "cSpell.enableFiletypes": [
    "!markdown"
  ]
}
