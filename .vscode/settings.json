{
  "java.compile.nullAnalysis.mode": "disabled",
  "maven.view": "hierarchical",
  "spring-boot.ls.problem.application-properties.PROP_UNKNOWN_PROPERTY": "WARNING",
  "java.configuration.updateBuildConfiguration": "automatic",

  // Java compiler settings - sync with Maven (Java 17)
  "java.jdt.ls.java.home": null,
  "java.errors.incompleteClasspath.severity": "ignore",

  // Disable resource leak warnings for Testcontainers static fields
  "java.eclipse.settings": {
    "org.eclipse.jdt.core.compiler.problem.potentiallyUnclosedCloseable": "ignore",
    "org.eclipse.jdt.core.compiler.problem.unclosedCloseable": "ignore",
    "org.eclipse.jdt.core.compiler.problem.explicitlyClosedAutoCloseable": "ignore"
  },

  // Disable ALL markdownlint rules (simplest approach)
  "markdownlint.config": {
    "default": false  // Disable all rules globally
  },

  // Disable all diagnostics for markdown files
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },

  // Exclude markdown from problem matcher
  "problems.exclude": ["**/*.md"]
}
