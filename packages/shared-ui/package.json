{
  "name": "@kite/shared-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-cutting UI components shared between kiteclass-frontend and kitehub-frontend (per ADR-024). Phase 1 = empty scaffolding; G* + D* components added per Track 2 wave-pack (GAP-273 + GAP-279).",
