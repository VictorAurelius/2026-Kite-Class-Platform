# PostgreSQL
POSTGRES_DB=kiteclass_dev
POSTGRES_USER=kiteclass
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=kiteclass
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq_password

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# Internal API Secret (HMAC auth between services)
INTERNAL_API_SECRET=CHANGE_ME_internal_api_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
