# =============================================================================
# KiteHub Terraform Variables
# =============================================================================
# First time setup:
#   1. cd bootstrap && terraform init && terraform apply
#   2. Copy bucket name from bootstrap output → update backend "s3" bucket in main.tf
#   3. cd .. && cp terraform.tfvars.example terraform.tfvars
#   4. terraform init   (migrates state to S3)
#   5. terraform plan
# =============================================================================

aws_region  = "ap-southeast-1"
environment = "production"

# EKS
eks_cluster_version    = "1.29"
eks_node_instance_type = "t3.medium"
eks_node_min_size      = 2
eks_node_max_size      = 5
eks_node_desired_size  = 2

# RDS
rds_instance_class    = "db.t3.medium"
rds_allocated_storage = 50
rds_multi_az          = true

# Redis
redis_node_type = "cache.t3.micro"

# Domain
domain_name = "kiteclass.com"
