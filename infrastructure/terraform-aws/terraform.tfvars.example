# =============================================================================
# Kite Platform — Phase 1 BETA Terraform Variables (Architecture B)
# =============================================================================
# First-time setup:
#   1. cd bootstrap && terraform init && terraform apply
#   2. Copy `state_bucket_name` output → update `bucket` value in ../backend.tf
#   3. cd .. && cp terraform.tfvars.example terraform.tfvars
#   4. Edit values below as needed
#   5. terraform init                    # migrates to S3 state
#   6. terraform plan                    # preview Architecture B resources
#   7. HUMAN runs `terraform apply`      # per GAP-381 Phase 2 BANNED for agent
# =============================================================================

# --- Region pin (DO NOT change without ADR-025 update) ---
aws_region  = "ap-southeast-1"
environment = "production"

# --- VPC ---
vpc_cidr           = "10.0.0.0/16"
enable_nat_gateway = false # Phase 1 BETA cost saving (~$32/mo)

# --- EC2 (Architecture B 2-instance topology) ---
kh_backend_instance_type = "t3.micro" # Free tier 750h/mo (covers 1 instance 24/7)
kc_app_instance_type     = "t3.micro" # Free tier
ec2_key_pair_name        = null       # Use SSM Session Manager instead of SSH

# --- RDS ---
rds_instance_class    = "db.t3.micro" # Free tier 12 months
rds_allocated_storage = 20            # Free tier covers 20GB
rds_multi_az          = false         # Phase 1 BETA single-AZ
rds_engine_version    = "15"

# --- ALB ---
enable_alb              = true
alb_acm_certificate_arn = null # Set after ACM cert validation; null = HTTP-only initial bring-up

# --- Domain / Route53 ---
domain_name         = "kiteclass.com"
manage_route53_zone = false # Cloudflare DNS is primary per ADR-018

# --- GitHub OIDC ---
github_repo = "VictorAurelius/2026-Kite-Class-Platform"
