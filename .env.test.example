# .env.test.example — Template cho dev self-test credentials (Wave 87 Bucket A)
#
# COPY file này thành `.env.test` và điền giá trị thực tế:
#   cp .env.test.example .env.test
#
# Sau đó: `bash scripts/dev/smoke-creds.sh` sẽ đọc từ `.env.test` nếu AWS Secrets
# Manager secret `kite/dev/smoke-creds` chưa tồn tại.
#
# .env.test PHẢI ở .gitignore — KHÔNG commit thật. File này (.env.test.example)
# committed để document fields cần thiết.
#
# Tham khảo: documents/03-planning/waves/wave-2026-05-17-87-dev-self-test-enablement.md §3 Bucket A

# ---------- Platform Admin ----------
ADMIN_EMAIL=admin@kitehub.test
ADMIN_PASSWORD=DevAdmin#2026

# ---------- P2 Center Owner ----------
OWNER_EMAIL=owner@sky-education.test
OWNER_PASSWORD=DevOwner#2026

# ---------- Teacher / Parent shared passwords ----------
# Mỗi role dùng chung 1 password cho dev seed; email pattern:
#   teacher{1,2}@sky-education.test
#   parent{1,2,3}@sky-education.test
TEACHER_PASSWORD=DevTeacher#2026
PARENT_PASSWORD=DevParent#2026

# ---------- Tenant ----------
TENANT_SLUG=sky-education

# ---------- Resend test inbox ----------
# URL dashboard Resend để verify email đã gửi (beta access confirmation, invite, etc.).
# Cập nhật sau khi setup Resend account.
RESEND_TEST_INBOX_URL=https://resend.com/emails

# ---------- AWS profile (optional) ----------
# Nếu muốn smoke-creds.sh ưu tiên AWS Secrets Manager, set AWS_PROFILE.
# Default: dev-admin (per CLAUDE.md AWS stack section).
AWS_PROFILE=dev-admin
AWS_REGION=ap-southeast-1
