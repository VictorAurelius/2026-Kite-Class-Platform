# KiteClass Core Service - Production Dockerfile
# Multi-stage build for optimal image size
# @since 1.0.0

# Stage 1: Build
FROM eclipse-temurin:17-jdk-alpine AS builder

WORKDIR /app

# Copy Maven wrapper and pom.xml
COPY kiteclass/kiteclass-core/.mvn .mvn
COPY kiteclass/kiteclass-core/mvnw .
COPY kiteclass/kiteclass-core/pom.xml .

# Download dependencies (cached layer)
RUN ./mvnw dependency:go-offline -B

# Copy source code
COPY kiteclass/kiteclass-core/src ./src

# Build application (skip tests - already run in CI)
RUN ./mvnw clean package -DskipTests -B

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

WORKDIR /app

# Copy JAR from builder stage
COPY --from=builder /app/target/*.jar app.jar

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1

# JVM options for container environment
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0"

# Spring profiles
ENV SPRING_PROFILES_ACTIVE=production

# Entry point
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

# Labels
LABEL maintainer="KiteClass Team"
LABEL service="kiteclass-core"
LABEL version="1.0.0"
LABEL description="KiteClass Core Service - Multi-tenant business logic"
