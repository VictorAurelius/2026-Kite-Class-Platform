{
  "name": "kite-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Kite Platform monorepo root — pnpm workspaces for shared UI lib (per ADR-024)",
  "workspaces": [
    "packages/*",
    "kiteclass/kiteclass-frontend",
    "kitehub/kitehub-frontend"
  ],
  "scripts": {
    "build:kc": "pnpm --filter kiteclass-frontend build",
    "build:kh": "pnpm --filter kitehub-frontend build",
    "build:all": "pnpm --recursive --parallel build",
    "lint:kc": "pnpm --filter kiteclass-frontend lint",
    "lint:kh": "pnpm --filter kitehub-frontend lint",
    "test:shared-ui": "pnpm --filter @kite/shared-ui test",
    "type-check:all": "pnpm --recursive --parallel type-check"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^4.0.4",
      "flatted": "^3.4.2",
      "minimatch": "^10.2.4",
      "rollup": "^4.59.0",
      "postcss": "^8.5.12",
      "ws@8": "^8.20.1",
      "brace-expansion@5": "^5.0.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6"
    },
    "onlyBuiltDependencies": [
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  }
}
