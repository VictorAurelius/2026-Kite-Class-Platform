@startuml erd
!theme plain
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam classBackgroundColor #FFFDE7
skinparam classBorderColor #888888
skinparam ArrowColor #555555

title KITECLASS INSTANCE DB - ENTITY RELATIONSHIP DIAGRAM (V4.1 + AI Branding v2)\nUpdated: 2026-04-26 (GAP-234)

' ==================== GATEWAY DB ====================
package "GATEWAY DATABASE" as GWDB #E3F2FD {

    package "Auth Module" as AUTH_MOD #BBDEFB {
        class users {
            id
            email <<UNIQUE>>
            password_hash
            first_name / last_name
            user_type (ADMIN/TEACHER/STUDENT/PARENT/TRIAL)
            reference_id
            status
            instance_id
        }
        class refresh_tokens {
            id
            user_id <<FK>>
            token_hash <<UNIQUE>>
            expires_at
            used / revoked
        }
        class password_reset_tokens {
            id
            user_id <<FK>>
            token_hash <<UNIQUE>>
            expires_at
            used
        }
    }
}

' ==================== CORE DB ====================
package "CORE DATABASE (Multi-tenant: instance_id)" as COREDB #FFF3E0 {

    ' --- PEOPLE ---
    package "People Module" as PEOPLE_MOD #FFECB3 {
        class students {
            id
            first_name / last_name
            email <<UNIQUE/tenant>>
            phone
            date_of_birth
            gender
            address
            parent_name / parent_phone
            status (ACTIVE/INACTIVE/SUSPENDED)
            instance_id
        }
        class teachers {
            id
            first_name / last_name
            email <<UNIQUE/tenant>>
            phone
            specialization
            experience_years
            bio
            status (ACTIVE/ON_LEAVE/TERMINATED)
            instance_id
        }
    }

    ' --- COURSE & CLASS ---
    package "Course & Class Module" as COURSE_MOD #FFE0B2 {
        class courses {
            id
            code <<UNIQUE/tenant>>
            name
            description / syllabus
            level / subject
            duration_months
            fee
            status (DRAFT/PUBLISHED/ARCHIVED)
            teacher_id <<FK>>
            instance_id
        }
        class classes {
            id
            code <<UNIQUE/tenant>>
            name
            course_id <<FK>>
            max_students
            start_date / end_date
            status (SCHEDULED/ONGOING/COMPLETED/CANCELLED)
            instance_id
        }
        class class_schedules {
            id
            class_id <<FK>>
            day_of_week
            start_time / end_time
            instance_id
        }
        class class_sessions {
            id
            class_id <<FK>>
            session_date
            start_time / end_time
            status (SCHEDULED/COMPLETED/CANCELLED)
            instance_id
        }
        class teacher_courses {
            teacher_id <<FK>>
            course_id <<FK>>
            role (MAIN/ASSISTANT)
        }
        class teacher_classes {
            teacher_id <<FK>>
            class_id <<FK>>
            role (MAIN/SUBSTITUTE)
        }
    }

    ' --- ENROLLMENT ---
    package "Enrollment Module" as ENROLL_MOD #C8E6C9 {
        class enrollments {
            id
            student_id <<FK>>
            class_id <<FK>>
            enrolled_at
            status (PENDING/ACTIVE/COMPLETED/CANCELLED/WAITLISTED)
            version
            instance_id
        }
    }

    ' --- ATTENDANCE ---
    package "Attendance Module" as ATTEND_MOD #A5D6A7 {
        class attendance {
            id
            enrollment_id <<FK>>
            session_id <<FK>>
            status (PRESENT/ABSENT/LATE/EXCUSED)
            check_in_time
            note
            instance_id
        }
    }

    ' --- GRADE ---
    package "Grade Module" as GRADE_MOD #80CBC4 {
        class grades {
            id
            enrollment_id <<FK>>
            grade_type (MIDTERM/FINAL/QUIZ/ASSIGNMENT)
            score / max_score
            comment
            graded_by <<FK>>
            instance_id
        }
    }

    ' --- BILLING ---
    package "Billing Module" as BILL_MOD #EF9A9A {
        class invoices {
            id
            invoice_number <<UNIQUE/tenant>>
            student_id <<FK>>
            class_id <<FK>>
            enrollment_id <<FK>>
            period_start / period_end
            subtotal / discount / total
            status (DRAFT/SENT/PAID/PARTIAL/OVERDUE/CANCELLED)
            due_date
            instance_id
        }
        class invoice_items {
            id
            invoice_id <<FK>>
            description
            quantity / unit_price / total
            instance_id
        }
        class payments {
            id
            invoice_id <<FK>>
            amount
            payment_method (CASH/BANK_TRANSFER/MOMO/VNPAY)
            transaction_id
            status (PENDING/COMPLETED/FAILED/REFUNDED)
            paid_at
            instance_id
        }
    }

    ' --- ASSIGNMENT ---
    package "Assignment Module" as ASSIGN_MOD #CE93D8 {
        class assignments {
            id
            class_id <<FK>>
            title / description
            due_date
            max_score
            instance_id
        }
        class assignment_submissions {
            id
            assignment_id <<FK>>
            student_id <<FK>>
            content / file_url
            score
            submitted_at
            instance_id
        }
    }

    ' --- LMS MODULE ---
    package "LMS Module (V4.1 NEW)" as LMS_MOD #B3E5FC {
        class course_modules {
            id
            course_id <<FK>>
            title / description
            order_index
            instance_id
        }
        class lessons {
            id
            module_id <<FK>>
            title / content
            video_url
            is_trial
            order_index
            instance_id
        }
        class learning_resources {
            id
            lesson_id <<FK>>
            type (PDF/VIDEO/SLIDE/LINK)
            title / url
            instance_id
        }
        class lesson_progress {
            id
            user_id <<FK>>
            lesson_id <<FK>>
            completed
            completed_at
            instance_id
        }
        class course_progress {
            id
            user_id <<FK>>
            course_id <<FK>>
            progress_percent
            last_accessed_at
            instance_id
        }
    }

    ' --- MARKETING MODULE ---
    package "Marketing Module (V4.1 NEW)" as MKT_MOD #E1BEE7 {
        class landing_page_content {
            id
            teacher_bio / tagline
            hero_image_url
            instance_id <<UNIQUE>>
        }
        class course_highlights {
            id
            content_id <<FK>>
            course_id <<FK>>
            order_index
        }
        class leads {
            id
            email / name / phone
            source (LANDING/TRIAL/CONTACT)
            status (NEW/CONTACTED/CONVERTED/LOST)
            instance_id
        }
        class contact_messages {
            id
            name / email / phone
            message
            instance_id
        }
    }

    ' --- STORAGE MODULE ---
    package "Storage Module" as STORAGE_MOD #F8BBD9 {
        class uploaded_files {
            id (UUID)
            uploaded_by <<FK>>
            file_type (AVATAR/DOCUMENT/VIDEO/CERTIFICATE)
            original_filename
            storage_path <<UNIQUE>>
            file_size_bytes
            mime_type
            status (UPLOADING/READY/FAILED/DELETED)
            access_level (PRIVATE/COURSE/PUBLIC)
            related_entity_type / id
            instance_id
        }
        class storage_quotas {
            id (UUID)
            instance_id <<UNIQUE>>
            quota_bytes / used_bytes
            last_calculated_at
        }
    }

    ' --- SETTINGS ---
    package "Settings Module" as SETTINGS_MOD #F5F5F5 {
        class settings {
            id
            key <<UNIQUE/tenant>>
            value
            instance_id
        }
    }

    ' --- AI BRANDING v2 (Waves 2-4) ---
    package "AI Branding v2 Module (V31-V45)" as BRANDING_V2_MOD #FFE082 {
        class frontend_instances {
            id (BIGSERIAL)
            instance_id <<UUID>>
            tenant_id
            slug
            frontend_url
            status (NOT_STARTED/INITIALIZING/
              GENERATING/DEPLOYED/
              REGENERATING/FAILED)
            initializing_at / generating_at
            deployed_at / failed_at
            last_regenerate_at
            retry_count / failure_reason
            branding_version
        }
        class branding_resources {
            id (BIGSERIAL)
            instance_id <<UUID>>
            type (LOGO/FAVICON/BANNER/HERO/
              COURSE_THUMBNAIL/SOCIAL_COVER/
              EMAIL_HEADER)
            category (STATIC/TEMPLATE/FULL_AI)
            storage_url
            template_id <<FK>>
            ai_job_id <<UUID>>
            metadata (JSONB)
        }
        class branding {
            id (BIGSERIAL)
            instance_id <<UUID>>
            logo_url / favicon_url
            display_name
            tagline
            primary_color / secondary_color
            accent_color
            theme_config_json
            contact_email / phone / address
            facebook_url / zalo_url / website_url
        }
        class branding_versions {
            id (BIGSERIAL)
            instance_id <<UUID>>
            version_number
            snapshot_json (JSONB)
            rollback_of <<FK self>>
            active
        }
        class quality_reports {
            id (BIGSERIAL)
            instance_id <<UUID>>
            target_instance_id <<FK>>
            branding_version
            score / passed
            contrast_score
            css_vars_score
            asset_urls_score
            visual_regression_score
            logo_placement_score
            issues (JSONB)
        }
        class moderation_queue {
            id (BIGSERIAL)
            instance_id <<UUID>>
            target_type / target_id
            status (PENDING/APPROVED/
              REJECTED/ESCALATED)
            flagged_keywords (JSONB)
            reason
            assigned_reviewer_id
            decided_at
        }
        class rebrand_approvals {
            id (BIGSERIAL)
            instance_id <<UUID>>
            target_instance_id <<FK>>
            status (PENDING/APPROVED/
              REJECTED/EXPIRED)
            initiator_user_id
            approver_user_id
            requested_at / approved_at
            rejected_at / expires_at
        }
        class outbox_events {
            id (BIGSERIAL)
            instance_id <<UUID>>
            aggregate_type / aggregate_id
            event_type
            payload (JSONB)
            status (PENDING/PUBLISHED/FAILED)
            retry_count / last_error
            published_at / next_attempt_at
        }
        class audit_log {
            id (BIGSERIAL)
            instance_id <<UUID>>
            action_type
            aggregate_type / aggregate_id
            actor_user_id / actor_role
            payload (JSONB)
            reason
        }
        class dmca_takedown_requests {
            id (BIGSERIAL)
            instance_id <<UUID>>
            reporter_email / reporter_name
            alleged_infringing_url
            copyrighted_work_description
            status (PENDING/APPROVED/
              REJECTED/CONTESTED/EXECUTED)
            counter_notice_email
            reviewer_user_id
            reviewed_at / executed_at
        }
        class deletion_requests {
            id (BIGSERIAL)
            instance_id <<UUID>>
            user_id / tenant_id
            status (REQUESTED/IN_GRACE/
              PROCESSING/COMPLETED/
              CANCELLED)
            requested_at
            grace_starts_at / grace_ends_at
            processing_started_at
            completed_at / cancelled_at
            data_export_url
        }
    }
}

' ==================== GATEWAY RELATIONSHIPS ====================
users ||--o{ refresh_tokens : "has"
users ||--o{ password_reset_tokens : "has"

' ==================== CORE RELATIONSHIPS ====================

' People - Course
teachers ||--o{ teacher_courses : "teaches"
courses  ||--o{ teacher_courses : "taught by"
teachers ||--o{ teacher_classes : "teaches"
classes  ||--o{ teacher_classes : "taught by"

' Course → Class
courses ||--o{ classes : "has"

' Class → Schedule & Session
classes ||--o{ class_schedules : "has"
classes ||--o{ class_sessions : "generates"

' Student → Enrollment
students ||--o{ enrollments : "enrolls"
classes  ||--o{ enrollments : "has"

' Enrollment → Attendance, Grade
enrollments ||--o{ attendance : "tracked"
class_sessions ||--o{ attendance : "for session"
enrollments ||--o{ grades : "graded"

' Enrollment → Invoice
enrollments ||--o{ invoices : "billed"
students ||--o{ invoices : "receives"
classes  ||--o{ invoices : "for"
invoices ||--o{ invoice_items : "has"
invoices ||--o{ payments : "paid by"

' Assignment
classes ||--o{ assignments : "has"
assignments ||--o{ assignment_submissions : "submitted by"
students ||--o{ assignment_submissions : "submits"

' LMS
courses ||--o{ course_modules : "has"
course_modules ||--o{ lessons : "contains"
lessons ||--o{ learning_resources : "has"
lessons ||--o{ lesson_progress : "tracked by"
courses ||--o{ course_progress : "tracked by"

' Marketing
landing_page_content ||--o{ course_highlights : "features"
courses ||--o{ course_highlights : "highlighted in"

' Storage
uploaded_files }o--|| storage_quotas : "counted in (instance)"

' AI Branding v2 relationships (per-instance)
frontend_instances ||--o{ branding_resources : "owns assets"
frontend_instances ||--o{ quality_reports : "scored by"
frontend_instances ||--o{ rebrand_approvals : "rebrand of"
frontend_instances ||--o{ branding_versions : "has snapshots"
branding_versions  ||--o{ branding_versions : "rollback_of"
moderation_queue   }o--o{ branding_resources : "moderates (target)"
audit_log          }o--o{ frontend_instances : "trail of"
outbox_events      }o--o{ frontend_instances : "publishes events"
dmca_takedown_requests }o--o{ branding_resources : "alleges"
deletion_requests  }o--|| frontend_instances : "purges"

@enduml
