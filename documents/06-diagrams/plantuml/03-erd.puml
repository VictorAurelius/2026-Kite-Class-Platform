@startuml erd
!theme plain
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam classBackgroundColor #FFFDE7
skinparam classBorderColor #888888
skinparam ArrowColor #555555

title KITECLASS INSTANCE DB - ENTITY RELATIONSHIP DIAGRAM (V4.1)\nUpdated: 2026-03-07

' ==================== GATEWAY DB ====================
package "GATEWAY DATABASE" as GWDB #E3F2FD {

    package "Auth Module" as AUTH_MOD #BBDEFB {
        class users {
            id
            email <<UNIQUE>>
            password_hash
            first_name / last_name
            user_type (ADMIN/TEACHER/STUDENT/PARENT/TRIAL)
            reference_id
            status
            instance_id
        }
        class refresh_tokens {
            id
            user_id <<FK>>
            token_hash <<UNIQUE>>
            expires_at
            used / revoked
        }
        class password_reset_tokens {
            id
            user_id <<FK>>
            token_hash <<UNIQUE>>
            expires_at
            used
        }
    }
}

' ==================== CORE DB ====================
package "CORE DATABASE (Multi-tenant: instance_id)" as COREDB #FFF3E0 {

    ' --- PEOPLE ---
    package "People Module" as PEOPLE_MOD #FFECB3 {
        class students {
            id
            first_name / last_name
            email <<UNIQUE/tenant>>
            phone
            date_of_birth
            gender
            address
            parent_name / parent_phone
            status (ACTIVE/INACTIVE/SUSPENDED)
            instance_id
        }
        class teachers {
            id
            first_name / last_name
            email <<UNIQUE/tenant>>
            phone
            specialization
            experience_years
            bio
            status (ACTIVE/ON_LEAVE/TERMINATED)
            instance_id
        }
    }

    ' --- COURSE & CLASS ---
    package "Course & Class Module" as COURSE_MOD #FFE0B2 {
        class courses {
            id
            code <<UNIQUE/tenant>>
            name
            description / syllabus
            level / subject
            duration_months
            fee
            status (DRAFT/PUBLISHED/ARCHIVED)
            teacher_id <<FK>>
            instance_id
        }
        class classes {
            id
            code <<UNIQUE/tenant>>
            name
            course_id <<FK>>
            max_students
            start_date / end_date
            status (SCHEDULED/ONGOING/COMPLETED/CANCELLED)
            instance_id
        }
        class class_schedules {
            id
            class_id <<FK>>
            day_of_week
            start_time / end_time
            instance_id
        }
        class class_sessions {
            id
            class_id <<FK>>
            session_date
            start_time / end_time
            status (SCHEDULED/COMPLETED/CANCELLED)
            instance_id
        }
        class teacher_courses {
            teacher_id <<FK>>
            course_id <<FK>>
            role (MAIN/ASSISTANT)
        }
        class teacher_classes {
            teacher_id <<FK>>
            class_id <<FK>>
            role (MAIN/SUBSTITUTE)
        }
    }

    ' --- ENROLLMENT ---
    package "Enrollment Module" as ENROLL_MOD #C8E6C9 {
        class enrollments {
            id
            student_id <<FK>>
            class_id <<FK>>
            enrolled_at
            status (PENDING/ACTIVE/COMPLETED/CANCELLED/WAITLISTED)
            version
            instance_id
        }
    }

    ' --- ATTENDANCE ---
    package "Attendance Module" as ATTEND_MOD #A5D6A7 {
        class attendance {
            id
            enrollment_id <<FK>>
            session_id <<FK>>
            status (PRESENT/ABSENT/LATE/EXCUSED)
            check_in_time
            note
            instance_id
        }
    }

    ' --- GRADE ---
    package "Grade Module" as GRADE_MOD #80CBC4 {
        class grades {
            id
            enrollment_id <<FK>>
            grade_type (MIDTERM/FINAL/QUIZ/ASSIGNMENT)
            score / max_score
            comment
            graded_by <<FK>>
            instance_id
        }
    }

    ' --- BILLING ---
    package "Billing Module" as BILL_MOD #EF9A9A {
        class invoices {
            id
            invoice_number <<UNIQUE/tenant>>
            student_id <<FK>>
            class_id <<FK>>
            enrollment_id <<FK>>
            period_start / period_end
            subtotal / discount / total
            status (DRAFT/SENT/PAID/PARTIAL/OVERDUE/CANCELLED)
            due_date
            instance_id
        }
        class invoice_items {
            id
            invoice_id <<FK>>
            description
            quantity / unit_price / total
            instance_id
        }
        class payments {
            id
            invoice_id <<FK>>
            amount
            payment_method (CASH/BANK_TRANSFER/MOMO/VNPAY)
            transaction_id
            status (PENDING/COMPLETED/FAILED/REFUNDED)
            paid_at
            instance_id
        }
    }

    ' --- ASSIGNMENT ---
    package "Assignment Module" as ASSIGN_MOD #CE93D8 {
        class assignments {
            id
            class_id <<FK>>
            title / description
            due_date
            max_score
            instance_id
        }
        class assignment_submissions {
            id
            assignment_id <<FK>>
            student_id <<FK>>
            content / file_url
            score
            submitted_at
            instance_id
        }
    }

    ' --- LMS MODULE ---
    package "LMS Module (V4.1 NEW)" as LMS_MOD #B3E5FC {
        class course_modules {
            id
            course_id <<FK>>
            title / description
            order_index
            instance_id
        }
        class lessons {
            id
            module_id <<FK>>
            title / content
            video_url
            is_trial
            order_index
            instance_id
        }
        class learning_resources {
            id
            lesson_id <<FK>>
            type (PDF/VIDEO/SLIDE/LINK)
            title / url
            instance_id
        }
        class lesson_progress {
            id
            user_id <<FK>>
            lesson_id <<FK>>
            completed
            completed_at
            instance_id
        }
        class course_progress {
            id
            user_id <<FK>>
            course_id <<FK>>
            progress_percent
            last_accessed_at
            instance_id
        }
    }

    ' --- MARKETING MODULE ---
    package "Marketing Module (V4.1 NEW)" as MKT_MOD #E1BEE7 {
        class landing_page_content {
            id
            teacher_bio / tagline
            hero_image_url
            instance_id <<UNIQUE>>
        }
        class course_highlights {
            id
            content_id <<FK>>
            course_id <<FK>>
            order_index
        }
        class leads {
            id
            email / name / phone
            source (LANDING/TRIAL/CONTACT)
            status (NEW/CONTACTED/CONVERTED/LOST)
            instance_id
        }
        class contact_messages {
            id
            name / email / phone
            message
            instance_id
        }
    }

    ' --- STORAGE MODULE ---
    package "Storage Module" as STORAGE_MOD #F8BBD9 {
        class uploaded_files {
            id (UUID)
            uploaded_by <<FK>>
            file_type (AVATAR/DOCUMENT/VIDEO/CERTIFICATE)
            original_filename
            storage_path <<UNIQUE>>
            file_size_bytes
            mime_type
            status (UPLOADING/READY/FAILED/DELETED)
            access_level (PRIVATE/COURSE/PUBLIC)
            related_entity_type / id
            instance_id
        }
        class storage_quotas {
            id (UUID)
            instance_id <<UNIQUE>>
            quota_bytes / used_bytes
            last_calculated_at
        }
    }

    ' --- SETTINGS ---
    package "Settings Module" as SETTINGS_MOD #F5F5F5 {
        class settings {
            id
            key <<UNIQUE/tenant>>
            value
            instance_id
        }
    }
}

' ==================== GATEWAY RELATIONSHIPS ====================
users ||--o{ refresh_tokens : "has"
users ||--o{ password_reset_tokens : "has"

' ==================== CORE RELATIONSHIPS ====================

' People - Course
teachers ||--o{ teacher_courses : "teaches"
courses  ||--o{ teacher_courses : "taught by"
teachers ||--o{ teacher_classes : "teaches"
classes  ||--o{ teacher_classes : "taught by"

' Course → Class
courses ||--o{ classes : "has"

' Class → Schedule & Session
classes ||--o{ class_schedules : "has"
classes ||--o{ class_sessions : "generates"

' Student → Enrollment
students ||--o{ enrollments : "enrolls"
classes  ||--o{ enrollments : "has"

' Enrollment → Attendance, Grade
enrollments ||--o{ attendance : "tracked"
class_sessions ||--o{ attendance : "for session"
enrollments ||--o{ grades : "graded"

' Enrollment → Invoice
enrollments ||--o{ invoices : "billed"
students ||--o{ invoices : "receives"
classes  ||--o{ invoices : "for"
invoices ||--o{ invoice_items : "has"
invoices ||--o{ payments : "paid by"

' Assignment
classes ||--o{ assignments : "has"
assignments ||--o{ assignment_submissions : "submitted by"
students ||--o{ assignment_submissions : "submits"

' LMS
courses ||--o{ course_modules : "has"
course_modules ||--o{ lessons : "contains"
lessons ||--o{ learning_resources : "has"
lessons ||--o{ lesson_progress : "tracked by"
courses ||--o{ course_progress : "tracked by"

' Marketing
landing_page_content ||--o{ course_highlights : "features"
courses ||--o{ course_highlights : "highlighted in"

' Storage
uploaded_files }o--|| storage_quotas : "counted in (instance)"

@enduml
