@startuml architecture-full
!theme plain
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam defaultFontSize 12
skinparam ArrowColor #555555

title KITECLASS PLATFORM V4.1 - KIẾN TRÚC HỆ THỐNG (BUNDLED MODEL)

' ==================== ACTORS ====================
actor "Guest / Phụ huynh" as GUEST #90CAF9
actor "Học viên" as STUDENT #A5D6A7
actor "Giảng viên" as TEACHER #FFB74D
actor "Admin Trung tâm" as ADMIN #EF9A9A

' ==================== FRONTEND ====================
package "Frontend\n[Next.js 14 | TypeScript | Tailwind | Shadcn/UI]" as FE #E3F2FD {
    component "Guest Pages\n(Landing, Catalog, Trial)" as FE_GUEST
    component "Auth Pages\n(Login, Register, Reset)" as FE_AUTH
    component "Admin Dashboard\n(Student, Teacher, Class,\nAttendance, Billing)" as FE_ADMIN
    component "Student Portal\n(Lessons, Progress)" as FE_STUDENT
}

' ==================== GATEWAY SERVICE ====================
package "Gateway Service\n[Spring Boot 3.5 | Port 8080]\n~400MB RAM" as GW #FFF3E0 {
    component "Auth & JWT" as GW_AUTH
    component "Rate Limiting\n(Redis)" as GW_RATE
    component "Internal API\n(HMAC Secret)" as GW_INTERNAL
    component "Email Service\n(Thymeleaf + SMTP)" as GW_EMAIL
    component "Cross-Service\nClient (Feign)" as GW_FEIGN

    database "Gateway DB\n[PostgreSQL]\nusers, roles,\nrefresh_tokens,\npassword_reset" as GW_DB #FB8C00
}

' ==================== CORE SERVICE ====================
package "Core Service\n[Spring Boot 3.5 | Port 8081]\n~900MB RAM" as CORE #FFF3E0 {

    package "Admin Module" as CORE_ADMIN #FFECB3 {
        component "Student & Teacher" as C_PEOPLE
        component "Course & Class\n& Schedule" as C_CLASS
        component "Enrollment" as C_ENROLL
        component "Attendance" as C_ATTEND
        component "Grade" as C_GRADE
        component "Invoice & Payment\n(Billing)" as C_BILLING
    }

    package "LMS Module\n(NEW - V4.1)" as CORE_LMS #C8E6C9 {
        component "CourseModule & Lesson\n& LearningResource" as C_LESSON
        component "LessonProgress\n& CourseProgress" as C_PROGRESS
        component "Assignment\n& Submission" as C_ASSIGN
        component "Trial Access Control\n(isTrial flag)" as C_TRIAL
    }

    package "Marketing Module\n(NEW - V4.1)" as CORE_MKT #E1BEE7 {
        component "LandingPageContent\n& CourseHighlight" as C_LANDING
        component "Lead Management\n(NEW → CONVERTED)" as C_LEAD
        component "Contact Message" as C_CONTACT
    }

    package "Storage Module" as CORE_STORAGE #B3E5FC {
        component "File Upload\n(Presigned URLs)" as C_UPLOAD
        component "Storage Quota\n(Per Tenant)" as C_QUOTA
    }

    database "Core DB\n[PostgreSQL]\n(Multi-tenant: instance_id)" as CORE_DB #F57C00
    queue "Message Queue\n[RabbitMQ]" as CORE_MQ #FF7043
    storage "Cache\n[Redis]" as CORE_CACHE #EF5350
}

' ==================== OBJECT STORAGE ====================
package "Object Storage" as OBJ #ECEFF1 {
    component "MinIO (Dev)\nAWS S3 (Prod)" as S3
}

' ==================== OPTIONAL ADDONS ====================
package "Optional Addons (Future)" as ADDONS #F3E5F5 {
    component "Parent Service\n₫100k/tháng" as SVC_PARENT
    component "Gamification\n₫150k/tháng" as SVC_GAME
    component "Forum / Q&A\n₫100k/tháng" as SVC_FORUM
    component "Media Service\n(Ant Media + MinIO)\n₫200-400k/tháng" as SVC_MEDIA
}

' ==================== EXTERNAL ====================
package "External Services" as EXT #CFD8DC {
    component "SMTP / Gmail" as EXT_EMAIL
    component "Zalo OTP" as EXT_ZALO
    component "VietQR" as EXT_QR
}

' ==================== ACTOR -> FRONTEND ====================
GUEST   --> FE_GUEST  : "Xem landing\nHọc thử"
STUDENT --> FE_STUDENT : "Học bài\nXem tiến độ"
TEACHER --> FE_ADMIN  : "Điểm danh\nChấm điểm"
ADMIN   --> FE_ADMIN  : "Quản lý\ntrung tâm"

' ==================== FRONTEND -> GATEWAY ====================
FE --> GW_AUTH : "REST API\n(HTTPS)"

' ==================== GATEWAY -> CORE ====================
GW_FEIGN --> CORE : "Internal REST\n(HMAC)"
GW_AUTH  --> GW_DB
GW_RATE  --> CORE_CACHE : "Rate limit\ncounters"
GW_EMAIL --> EXT_EMAIL

' ==================== CORE INTERNAL ====================
CORE_ADMIN   --> CORE_DB
CORE_LMS     --> CORE_DB
CORE_MKT     --> CORE_DB
CORE_STORAGE --> CORE_DB
CORE_STORAGE --> S3 : "Presigned\nURLs"
C_BILLING --> EXT_QR : "QR Payment"
CORE_ADMIN --> CORE_MQ : "Events"
CORE_ADMIN --> CORE_CACHE

' ==================== ADDONS -> CORE ====================
SVC_PARENT ..> CORE : "Read API"
SVC_GAME   ..> CORE_MQ : "Consume events"
SVC_FORUM  ..> CORE : "Read API"
SVC_MEDIA  ..> CORE : "Link videos"

' ==================== EXTERNAL ====================
GW_AUTH --> EXT_ZALO : "OTP"

' ==================== LEGEND ====================
legend right
|= Service |= RAM |= Port |= Required |
| Frontend | ~250MB | 3000 | Yes |
| Gateway  | ~400MB | 8080 | Yes |
| Core     | ~900MB | 8081 | Yes |
| PostgreSQL | ~200MB | 5432 | Yes |
| Redis    | ~100MB | 6379 | Yes |
| RabbitMQ | ~150MB | 5672 | Yes |
| MinIO    | ~200MB | 9000 | Yes (Dev) |
| Parent / Gamification / Forum | 150MB ea | - | Optional |
| Media Service | ~800MB | - | Optional |

|= Core Module |= Status |
| Admin (Student, Teacher, Class, Attendance, Billing) | Implemented |
| LMS (Lessons, Progress, Assignment) | V4.1 NEW |
| Marketing (Landing, Lead, Contact) | V4.1 NEW |
| Storage (Files, Quota) | Implemented |
endlegend

note bottom of CORE
  **Multi-tenant isolation**
  - instance_id trên mọi bảng
  - Hibernate @Filter tự động
  - TenantContext per request
end note

note right of GW
  **Authentication Flow**
  1. Login → JWT (15min) + Refresh (7d)
  2. Request → Validate JWT
  3. Internal → HMAC secret
  4. Forgot PW → Email token
end note

@enduml
