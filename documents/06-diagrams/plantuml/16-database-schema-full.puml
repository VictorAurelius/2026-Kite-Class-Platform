@startuml database-schema-full
!theme plain
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam defaultFontSize 10
skinparam packageStyle rectangle
skinparam classBackgroundColor #FFFDE7
skinparam classBorderColor #888888
skinparam ArrowColor #555555

title KITE PLATFORM - FULL DATABASE SCHEMA\nKiteHub Platform DB + KiteClass Tenant DB + AI Branding v2 (V31-V45)\nUpdated: 2026-04-26 (GAP-234)

' ==================== KITEHUB PLATFORM DB ====================
package "KiteHub Platform DB (kitehub)" as KHDB #E8EAF6 {

    class users {
        **id** : UUID <<PK>>
        --
        email : VARCHAR(255) <<UNIQUE>>
        password_hash : VARCHAR(255)
        full_name : VARCHAR(200)
        role : VARCHAR(20)
        email_verified : BOOLEAN
        verification_token : VARCHAR(255)
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class instances {
        **id** : UUID <<PK>>
        --
        subdomain : VARCHAR(50) <<UNIQUE>>
        custom_domain : VARCHAR(255)
        domain_verified : BOOLEAN
        domain_verification_token : VARCHAR(255)
        organization_name : VARCHAR(200)
        owner_id : UUID <<FK users>>
        contact_email : VARCHAR(255)
        --
        tier : ENUM(FREE, BASIC, PREMIUM, ENTERPRISE)
        status : ENUM(TRIAL, ACTIVE, SUSPENDED, DELETED)
        --
        database_url : VARCHAR(500)
        database_username : VARCHAR(100)
        database_password : VARCHAR(255) <<AES-256>>
        --
        trial_started_at : TIMESTAMP
        trial_expires_at : TIMESTAMP
        subscription_id : UUID <<FK>>
        subscription_expires_at : TIMESTAMP
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class subscriptions {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        tier : ENUM(FREE, BASIC, PREMIUM, ENTERPRISE)
        billing_cycle : ENUM(MONTHLY, ANNUALLY)
        price_vnd : BIGINT
        status : ENUM(ACTIVE, CANCELLED, EXPIRED, SUSPENDED)
        --
        started_at / expires_at : TIMESTAMP
        auto_renew : BOOLEAN
        pending_tier : VARCHAR(20)
        pending_payment_id : UUID <<FK payments>>
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class payments {
        **id** : UUID <<PK>>
        --
        subscription_id : UUID <<FK subscriptions>>
        amount_vnd : BIGINT
        currency : VARCHAR(3)
        payment_method : ENUM(VIETQR, MOMO, VNPAY, BANK_TRANSFER, MANUAL)
        status : ENUM(PENDING, COMPLETED, FAILED, REFUNDED)
        --
        qr_code_url : VARCHAR(500)
        transaction_id : VARCHAR(100)
        bank_code : VARCHAR(20)
        payment_content : VARCHAR(500)
        --
        paid_at / refunded_at : TIMESTAMP
        refund_reason : VARCHAR(500)
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    note right of instances
      **AI Branding v2 deviation (2026-04-26 / GAP-234)**

      Original v1 spec placed branding_jobs +
      branding_templates in the KiteHub platform DB.

      Wave 2-4 implementation moved AI Branding
      tables into the KiteClass tenant DB
      (V31-V45 migrations) so branding lifecycle
      is co-located with the tenant data it themes.

      kitehub-branding service still owns the
      RabbitMQ queue topology + worker pool +
      AIQueueDispatcher (cross-tenant fair scheduler).

      branding_jobs / branding_templates kept here
      as legacy (HISTORICAL) — current tables
      live in KiteClass schema below.
    end note

    class branding_jobs <<HISTORICAL>> {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        status : ENUM(QUEUED, PROCESSING, COMPLETED, FAILED, CANCELLED)
        progress : INTEGER (0-100)
        current_step : VARCHAR(100)
        --
        logo_url : VARCHAR(500)
        organization_name : VARCHAR(200)
        brand_personality : VARCHAR(50)
        color_scheme : VARCHAR(50)
        language : VARCHAR(10)
        --
        logo_analysis : JSON
        assets_generated : JSON
        error_message : TEXT
        retry_count : INTEGER
        --
        queued_at / started_at / completed_at : TIMESTAMP
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
        --
        **superseded by V31-V45 in KiteClass**
    }

    class branding_templates <<HISTORICAL>> {
        **id** : UUID <<PK>>
        --
        name : VARCHAR(100) <<UNIQUE>>
        description : TEXT
        preview_url : VARCHAR(500)
        category : VARCHAR(50)
        personality : VARCHAR(50)
        is_active : BOOLEAN
        --
        created_at / updated_at : TIMESTAMP
        --
        **superseded by branding_resources.template_id\nin KiteClass schema (V32)**
    }

    class ai_usage_log {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        branding_job_id : UUID <<FK branding_jobs>>
        model : VARCHAR(50)
        operation : VARCHAR(50)
        tokens_input : INTEGER
        tokens_output : INTEGER
        cost_usd : DECIMAL(10,6)
        --
        created_at : TIMESTAMP
    }

    class email_logs {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        recipient_email : VARCHAR(255)
        subject : VARCHAR(500)
        template_name : VARCHAR(100)
        template_variables : JSON
        --
        message_id : VARCHAR(255)
        status : ENUM(QUEUED, SENT, DELIVERED, BOUNCED, COMPLAINED)
        --
        sent_at / delivered_at / bounced_at : TIMESTAMP
        error_message : TEXT
        bounce_type : VARCHAR(50)
        retry_count : INTEGER
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class email_sent_log {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        email_type : VARCHAR(50)
        sent_at : TIMESTAMP
        --
        created_at : TIMESTAMP
    }
}

' ==================== KITEHUB RELATIONSHIPS ====================
users ||--o{ instances : "owns"
instances ||--o{ subscriptions : "has"
subscriptions ||--o{ payments : "paid by"
instances ||--o{ branding_jobs : "generates"
instances ||--o{ email_logs : "receives"
instances ||--o{ email_sent_log : "tracks"
instances ||--o{ ai_usage_log : "uses AI"
branding_jobs ||--o{ ai_usage_log : "logs usage"

' ==================== KITECLASS TENANT DB ====================
package "KiteClass Tenant DB (kiteclass_{id})" as KCDB #E8F5E9 {

    class kc_users <<tenant>> {
        **id** : UUID <<PK>>
        --
        email / username / password_hash
        full_name / phone / role
        tenant_id : UUID
        --
        created_at / updated_at
    }

    class kc_students <<tenant>> {
        **id** : UUID <<PK>>
        --
        user_id : UUID <<FK>>
        student_code : VARCHAR
        date_of_birth : DATE
        parent_name / parent_phone
        tenant_id : UUID
    }

    class kc_teachers <<tenant>> {
        **id** : UUID <<PK>>
        --
        user_id : UUID <<FK>>
        specialization : VARCHAR
        bio : TEXT
        hourly_rate : DECIMAL
        tenant_id : UUID
    }

    class kc_courses <<tenant>> {
        **id** : UUID <<PK>>
        --
        name / description / code
        category / level / price
        max_students : INTEGER
        teacher_id : UUID <<FK>>
        tenant_id : UUID
    }

    class kc_classes <<tenant>> {
        **id** : UUID <<PK>>
        --
        course_id : UUID <<FK>>
        name / schedule / room
        start_date / end_date
        status : VARCHAR
        tenant_id : UUID
    }

    class kc_enrollments <<tenant>> {
        **id** : UUID <<PK>>
        --
        student_id : UUID <<FK>>
        class_id : UUID <<FK>>
        status : ENUM(ACTIVE, COMPLETED, DROPPED)
        enrolled_at : TIMESTAMP
        tenant_id : UUID
    }

    class kc_attendance <<tenant>> {
        **id** : UUID <<PK>>
        --
        enrollment_id : UUID <<FK>>
        class_id : UUID <<FK>>
        date : DATE
        status : ENUM(PRESENT, ABSENT, LATE, EXCUSED)
        tenant_id : UUID
    }

    class kc_grades <<tenant>> {
        **id** : UUID <<PK>>
        --
        enrollment_id : UUID <<FK>>
        assignment_id : UUID <<FK>>
        score : DECIMAL
        feedback : TEXT
        tenant_id : UUID
    }

    class kc_assignments <<tenant>> {
        **id** : UUID <<PK>>
        --
        class_id : UUID <<FK>>
        title / description
        type : VARCHAR
        max_score : DECIMAL
        due_date : TIMESTAMP
        tenant_id : UUID
    }

    class kc_invoices <<tenant>> {
        **id** : UUID <<PK>>
        --
        student_id : UUID <<FK>>
        amount / status / due_date
        tenant_id : UUID
    }

    class kc_payments <<tenant>> {
        **id** : UUID <<PK>>
        --
        invoice_id : UUID <<FK>>
        amount / method / status
        paid_at : TIMESTAMP
        tenant_id : UUID
    }

    class kc_settings <<tenant>> {
        **id** : UUID <<PK>>
        --
        key : VARCHAR <<UNIQUE>>
        value : TEXT
        category : VARCHAR
        tenant_id : UUID
    }

    ' ===== AI Branding v2 (V31-V45 — kiteclass-core) =====
    class frontend_instances <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        tenant_id : VARCHAR(100)
        slug : VARCHAR(80)
        frontend_url : VARCHAR(300)
        --
        status : ENUM(NOT_STARTED, INITIALIZING,
          GENERATING, DEPLOYED,
          REGENERATING, FAILED)
        initializing_at / generating_at : TIMESTAMP
        deployed_at / failed_at : TIMESTAMP
        last_regenerate_at : TIMESTAMP
        retry_count : INT
        failure_reason : VARCHAR(1000)
        branding_version : INT
        --
        deleted : BOOLEAN
    }

    class branding_resources <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        type : ENUM(LOGO, FAVICON, BANNER, HERO,
          COURSE_THUMBNAIL, SOCIAL_COVER,
          EMAIL_HEADER)
        category : ENUM(STATIC, TEMPLATE, FULL_AI)
        storage_url : VARCHAR(500)
        template_id : BIGINT <<FK>>
        ai_job_id : UUID
        metadata : JSONB
        --
        deleted : BOOLEAN
    }

    class branding <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        logo_url / favicon_url : VARCHAR(500)
        display_name : VARCHAR(200)
        tagline : VARCHAR(500)
        primary_color / secondary_color
          / accent_color : VARCHAR(7)
        theme_config_json : TEXT
        contact_email / phone / address
        facebook_url / zalo_url / website_url
    }

    class branding_versions <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        version_number : INT
        snapshot_json : JSONB
        rollback_of : BIGINT <<FK self>>
        active : BOOLEAN
    }

    class quality_reports <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        target_instance_id : BIGINT <<FK>>
        branding_version : INT
        score : INT
        passed : BOOLEAN
        contrast_score : INT
        css_vars_score : INT
        asset_urls_score : INT
        visual_regression_score : INT
        logo_placement_score : INT
        issues : JSONB
    }

    class moderation_queue <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        target_type / target_id : VARCHAR
        status : ENUM(PENDING, APPROVED,
          REJECTED, ESCALATED)
        flagged_keywords : JSONB
        reason : VARCHAR(500)
        assigned_reviewer_id : BIGINT
        decided_at : TIMESTAMP
    }

    class rebrand_approvals <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        target_instance_id : BIGINT <<FK>>
        status : ENUM(PENDING, APPROVED,
          REJECTED, EXPIRED)
        initiator_user_id : BIGINT
        approver_user_id : BIGINT
        requested_at / approved_at : TIMESTAMP
        rejected_at / expires_at : TIMESTAMP
    }

    class outbox_events <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        aggregate_type / aggregate_id : VARCHAR
        event_type : VARCHAR(100)
        payload : JSONB
        status : ENUM(PENDING, PUBLISHED, FAILED)
        retry_count : INT
        last_error : TEXT
        published_at : TIMESTAMP
        next_attempt_at : TIMESTAMP
    }

    class audit_log <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        action_type : VARCHAR(100)
        aggregate_type / aggregate_id : VARCHAR
        actor_user_id : BIGINT
        actor_role : VARCHAR(50)
        payload : JSONB
        reason : VARCHAR(500)
    }

    class dmca_takedown_requests <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        reporter_email : VARCHAR(255)
        reporter_name : VARCHAR(255)
        alleged_infringing_url : VARCHAR(2000)
        copyrighted_work_description : VARCHAR(4000)
        status : ENUM(PENDING, APPROVED,
          REJECTED, CONTESTED, EXECUTED)
        counter_notice_email : VARCHAR(255)
        reviewer_user_id : BIGINT
        reviewed_at / executed_at : TIMESTAMP
    }

    class deletion_requests <<v2>> {
        **id** : BIGSERIAL <<PK>>
        --
        instance_id : UUID
        user_id : BIGINT
        tenant_id : UUID
        status : ENUM(REQUESTED, IN_GRACE,
          PROCESSING, COMPLETED, CANCELLED)
        requested_at : TIMESTAMP
        grace_starts_at / grace_ends_at : TIMESTAMP
        processing_started_at : TIMESTAMP
        completed_at / cancelled_at : TIMESTAMP
        data_export_url : VARCHAR(1024)
    }
}

' ==================== KITECLASS RELATIONSHIPS ====================
kc_users ||--o| kc_students : "is"
kc_users ||--o| kc_teachers : "is"
kc_teachers ||--o{ kc_courses : "teaches"
kc_courses ||--o{ kc_classes : "has"
kc_students ||--o{ kc_enrollments : "enrolls"
kc_classes ||--o{ kc_enrollments : "contains"
kc_enrollments ||--o{ kc_attendance : "tracks"
kc_enrollments ||--o{ kc_grades : "scored"
kc_classes ||--o{ kc_assignments : "has"
kc_students ||--o{ kc_invoices : "billed"
kc_invoices ||--o{ kc_payments : "paid by"

' ==================== AI BRANDING v2 RELATIONSHIPS ====================
frontend_instances ||--o{ branding_resources : "owns"
frontend_instances ||--o{ quality_reports : "scored by"
frontend_instances ||--o{ rebrand_approvals : "rebrand of"
frontend_instances ||--o{ branding_versions : "snapshots"
branding_versions  ||--o{ branding_versions : "rollback_of"
moderation_queue   }o--o{ branding_resources : "moderates"
audit_log          }o--o{ frontend_instances : "trail of"
outbox_events      }o--o{ frontend_instances : "publishes events"
dmca_takedown_requests }o--o{ branding_resources : "alleges"
deletion_requests  }o--|| frontend_instances : "purges"

' ==================== PROVISIONING LINK ====================
instances ..> KCDB : "provisions\n(CREATE DB + Flyway V1-V18)"

' ==================== LEGEND ====================
legend right
|= DB |= Migrations |= Tables |
| kitehub | V1-V14 | 8 tables (incl. legacy branding_jobs / branding_templates) |
| kiteclass_{id} | V1-V45 | 25+ tables (incl. AI Branding v2 V31-V45) |
|= Isolation |
| Each tenant: own PostgreSQL DB |
| Flyway migrations per tenant |
| tenant_id column for safety |
|= AI Branding v2 (per GAP-234) |
| Workflow code lives in kiteclass-core (Wave 2-4) |
| Tables co-located with tenant data |
| Queue topology stays in kitehub-branding |
| Provider: local Ollama (llama3.1+llava); Gemma 4 9B planned |
endlegend

@enduml
