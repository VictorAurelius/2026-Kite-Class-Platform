@startuml database-schema-full
!theme plain
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam defaultFontSize 10
skinparam packageStyle rectangle
skinparam classBackgroundColor #FFFDE7
skinparam classBorderColor #888888
skinparam ArrowColor #555555

title KITE PLATFORM - FULL DATABASE SCHEMA\nKiteHub Platform DB + KiteClass Tenant DB | 2026-03-24

' ==================== KITEHUB PLATFORM DB ====================
package "KiteHub Platform DB (kitehub)" as KHDB #E8EAF6 {

    class users {
        **id** : UUID <<PK>>
        --
        email : VARCHAR(255) <<UNIQUE>>
        password_hash : VARCHAR(255)
        full_name : VARCHAR(200)
        role : VARCHAR(20)
        email_verified : BOOLEAN
        verification_token : VARCHAR(255)
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class instances {
        **id** : UUID <<PK>>
        --
        subdomain : VARCHAR(50) <<UNIQUE>>
        custom_domain : VARCHAR(255)
        domain_verified : BOOLEAN
        domain_verification_token : VARCHAR(255)
        organization_name : VARCHAR(200)
        owner_id : UUID <<FK users>>
        contact_email : VARCHAR(255)
        --
        tier : ENUM(FREE, BASIC, PREMIUM, ENTERPRISE)
        status : ENUM(TRIAL, ACTIVE, SUSPENDED, DELETED)
        --
        database_url : VARCHAR(500)
        database_username : VARCHAR(100)
        database_password : VARCHAR(255) <<AES-256>>
        --
        trial_started_at : TIMESTAMP
        trial_expires_at : TIMESTAMP
        subscription_id : UUID <<FK>>
        subscription_expires_at : TIMESTAMP
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class subscriptions {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        tier : ENUM(FREE, BASIC, PREMIUM, ENTERPRISE)
        billing_cycle : ENUM(MONTHLY, ANNUALLY)
        price_vnd : BIGINT
        status : ENUM(ACTIVE, CANCELLED, EXPIRED, SUSPENDED)
        --
        started_at / expires_at : TIMESTAMP
        auto_renew : BOOLEAN
        pending_tier : VARCHAR(20)
        pending_payment_id : UUID <<FK payments>>
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class payments {
        **id** : UUID <<PK>>
        --
        subscription_id : UUID <<FK subscriptions>>
        amount_vnd : BIGINT
        currency : VARCHAR(3)
        payment_method : ENUM(VIETQR, MOMO, VNPAY, BANK_TRANSFER, MANUAL)
        status : ENUM(PENDING, COMPLETED, FAILED, REFUNDED)
        --
        qr_code_url : VARCHAR(500)
        transaction_id : VARCHAR(100)
        bank_code : VARCHAR(20)
        payment_content : VARCHAR(500)
        --
        paid_at / refunded_at : TIMESTAMP
        refund_reason : VARCHAR(500)
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class branding_jobs {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        status : ENUM(QUEUED, PROCESSING, COMPLETED, FAILED, CANCELLED)
        progress : INTEGER (0-100)
        current_step : VARCHAR(100)
        --
        logo_url : VARCHAR(500)
        organization_name : VARCHAR(200)
        brand_personality : VARCHAR(50)
        color_scheme : VARCHAR(50)
        language : VARCHAR(10)
        --
        logo_analysis : JSON
        assets_generated : JSON
        error_message : TEXT
        retry_count : INTEGER
        --
        queued_at / started_at / completed_at : TIMESTAMP
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class branding_templates {
        **id** : UUID <<PK>>
        --
        name : VARCHAR(100) <<UNIQUE>>
        description : TEXT
        preview_url : VARCHAR(500)
        category : VARCHAR(50)
        personality : VARCHAR(50)
        is_active : BOOLEAN
        --
        created_at / updated_at : TIMESTAMP
    }

    class ai_usage_log {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        branding_job_id : UUID <<FK branding_jobs>>
        model : VARCHAR(50)
        operation : VARCHAR(50)
        tokens_input : INTEGER
        tokens_output : INTEGER
        cost_usd : DECIMAL(10,6)
        --
        created_at : TIMESTAMP
    }

    class email_logs {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        recipient_email : VARCHAR(255)
        subject : VARCHAR(500)
        template_name : VARCHAR(100)
        template_variables : JSON
        --
        message_id : VARCHAR(255)
        status : ENUM(QUEUED, SENT, DELIVERED, BOUNCED, COMPLAINED)
        --
        sent_at / delivered_at / bounced_at : TIMESTAMP
        error_message : TEXT
        bounce_type : VARCHAR(50)
        retry_count : INTEGER
        --
        created_at / updated_at : TIMESTAMP
        deleted : BOOLEAN
    }

    class email_sent_log {
        **id** : UUID <<PK>>
        --
        instance_id : UUID <<FK instances>>
        email_type : VARCHAR(50)
        sent_at : TIMESTAMP
        --
        created_at : TIMESTAMP
    }
}

' ==================== KITEHUB RELATIONSHIPS ====================
users ||--o{ instances : "owns"
instances ||--o{ subscriptions : "has"
subscriptions ||--o{ payments : "paid by"
instances ||--o{ branding_jobs : "generates"
instances ||--o{ email_logs : "receives"
instances ||--o{ email_sent_log : "tracks"
instances ||--o{ ai_usage_log : "uses AI"
branding_jobs ||--o{ ai_usage_log : "logs usage"

' ==================== KITECLASS TENANT DB ====================
package "KiteClass Tenant DB (kiteclass_{id})" as KCDB #E8F5E9 {

    class kc_users <<tenant>> {
        **id** : UUID <<PK>>
        --
        email / username / password_hash
        full_name / phone / role
        tenant_id : UUID
        --
        created_at / updated_at
    }

    class kc_students <<tenant>> {
        **id** : UUID <<PK>>
        --
        user_id : UUID <<FK>>
        student_code : VARCHAR
        date_of_birth : DATE
        parent_name / parent_phone
        tenant_id : UUID
    }

    class kc_teachers <<tenant>> {
        **id** : UUID <<PK>>
        --
        user_id : UUID <<FK>>
        specialization : VARCHAR
        bio : TEXT
        hourly_rate : DECIMAL
        tenant_id : UUID
    }

    class kc_courses <<tenant>> {
        **id** : UUID <<PK>>
        --
        name / description / code
        category / level / price
        max_students : INTEGER
        teacher_id : UUID <<FK>>
        tenant_id : UUID
    }

    class kc_classes <<tenant>> {
        **id** : UUID <<PK>>
        --
        course_id : UUID <<FK>>
        name / schedule / room
        start_date / end_date
        status : VARCHAR
        tenant_id : UUID
    }

    class kc_enrollments <<tenant>> {
        **id** : UUID <<PK>>
        --
        student_id : UUID <<FK>>
        class_id : UUID <<FK>>
        status : ENUM(ACTIVE, COMPLETED, DROPPED)
        enrolled_at : TIMESTAMP
        tenant_id : UUID
    }

    class kc_attendance <<tenant>> {
        **id** : UUID <<PK>>
        --
        enrollment_id : UUID <<FK>>
        class_id : UUID <<FK>>
        date : DATE
        status : ENUM(PRESENT, ABSENT, LATE, EXCUSED)
        tenant_id : UUID
    }

    class kc_grades <<tenant>> {
        **id** : UUID <<PK>>
        --
        enrollment_id : UUID <<FK>>
        assignment_id : UUID <<FK>>
        score : DECIMAL
        feedback : TEXT
        tenant_id : UUID
    }

    class kc_assignments <<tenant>> {
        **id** : UUID <<PK>>
        --
        class_id : UUID <<FK>>
        title / description
        type : VARCHAR
        max_score : DECIMAL
        due_date : TIMESTAMP
        tenant_id : UUID
    }

    class kc_invoices <<tenant>> {
        **id** : UUID <<PK>>
        --
        student_id : UUID <<FK>>
        amount / status / due_date
        tenant_id : UUID
    }

    class kc_payments <<tenant>> {
        **id** : UUID <<PK>>
        --
        invoice_id : UUID <<FK>>
        amount / method / status
        paid_at : TIMESTAMP
        tenant_id : UUID
    }

    class kc_settings <<tenant>> {
        **id** : UUID <<PK>>
        --
        key : VARCHAR <<UNIQUE>>
        value : TEXT
        category : VARCHAR
        tenant_id : UUID
    }
}

' ==================== KITECLASS RELATIONSHIPS ====================
kc_users ||--o| kc_students : "is"
kc_users ||--o| kc_teachers : "is"
kc_teachers ||--o{ kc_courses : "teaches"
kc_courses ||--o{ kc_classes : "has"
kc_students ||--o{ kc_enrollments : "enrolls"
kc_classes ||--o{ kc_enrollments : "contains"
kc_enrollments ||--o{ kc_attendance : "tracks"
kc_enrollments ||--o{ kc_grades : "scored"
kc_classes ||--o{ kc_assignments : "has"
kc_students ||--o{ kc_invoices : "billed"
kc_invoices ||--o{ kc_payments : "paid by"

' ==================== PROVISIONING LINK ====================
instances ..> KCDB : "provisions\n(CREATE DB + Flyway V1-V18)"

' ==================== LEGEND ====================
legend right
|= DB |= Migrations |= Tables |
| kitehub | V1-V14 | 8 tables |
| kiteclass_{id} | V1-V18 | 12+ tables |
|= Isolation |
| Each tenant: own PostgreSQL DB |
| Flyway migrations per tenant |
| tenant_id column for safety |
endlegend

@enduml
