<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <groupId>com.kitehub</groupId>
    <artifactId>kitehub-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>KiteHub Platform</name>
    <description>Multi-tenant SaaS platform for KiteClass instances</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.46</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <springdoc.version>2.8.17</springdoc.version>
        <!-- GAP-203: pinned to fix CVEs surfaced via GitHub code-scanning 2026-04-21 -->
        <!-- Tomcat pinned > Spring Boot BOM. 10.1.55 resolves CVE-2026-41284/41293/42498/43512/43513/43514/43515 (3 critical + 3 high + 1 low) on top of prior CVE-2026-34483/34487/34500 (GAP-806) -->
        <tomcat.version>10.1.55</tomcat.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <poi.version>5.5.1</poi.version>
        <!-- GAP-114: structured JSON logging via LogstashEncoder (Spring Boot 3.5.x compatible) -->
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>
        <!-- GAP-468: CVE overrides for transitive deps surfaced via GitHub code-scanning 2026-05-11 -->
        <!-- GAP-470: netty 4.2.13.Final fixes CVE-2026-42577 (advisory revised — no 4.1.x patch; 4.2.13 closes 5 HIGH CVEs incl epoll DoS) -->
        <netty.version>4.2.15.Final</netty.version>
        <!-- postgresql 42.7.11 fixes CVE-2026-42198 (Spring Boot 3.5.14 ships 42.7.10) -->
        <postgresql.version>42.7.12</postgresql.version>
        <!-- bcprov-jdk18on 1.84 fixes CVE-2026-5598 (not managed by Spring Boot BOM; transitive) -->
        <bouncycastle.version>1.84</bouncycastle.version>
        <!-- commons-lang3 3.18.0 fixes CVE-2025-48924 (Spring Boot 3.5.14 ships 3.17.0) -->
        <commons-lang3.version>3.18.0</commons-lang3.version>
    </properties>

    <modules>
        <module>kitehub-platform</module>
        <module>kitehub-subscription</module>
        <module>kitehub-branding</module>
        <module>kitehub-email</module>
        <module>kitehub-admin</module>
        <module>kitehub-gateway</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.kitehub</groupId>
                <artifactId>kitehub-platform</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Testcontainers BOM -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- GAP-569: CVE-2026-45292 OpenTelemetry Unbounded Memory Allocation in W3C Baggage Propagation (MEDIUM).
                 Spring Boot 3.5.14 BOM pins OTel 1.49.0 (affected); bump via opentelemetry-bom 1.62.0.
                 Affected artifacts (transitive via opentelemetry-exporter-otlp + micrometer-tracing-bridge-otel):
                   - io.opentelemetry:opentelemetry-api
                   - io.opentelemetry:opentelemetry-extension-trace-propagators -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>1.62.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- GAP-203: CVE overrides for transitive deps -->
            <!-- Tomcat version pinned via <tomcat.version> property (Spring Boot parent respects it) -->
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>${commons-beanutils.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>

            <!-- GAP-114: structured JSON logging — used by per-service logback-spring.xml -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <!-- GAP-468: netty-bom override forces all netty-* artifacts to 4.1.133.Final (closes 5 HIGH CVE) -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- GAP-468: bcprov-jdk18on 1.84 (CVE-2026-5598) -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- Spring Boot 3.5.14 BOM hard-pins these (property override alone không thắng); cần explicit dependencyManagement entry -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              GAP-1344: JaCoCo coverage — mirrors kiteclass-core config so the
              kitehub multi-module reactor emits line/branch coverage instead of
              the file-count proxy the quality audit was forced to use.

              Declared in the parent <build><plugins> so all 6 child modules
              inherit it (platform / subscription / branding / email / admin / gateway).

              Phase wiring (same as kiteclass-core/pom.xml):
                - prepare-agent             → before surefire (writes target/jacoco.exec)
                - prepare-agent-integration → before failsafe (writes target/jacoco-it.exec)
                - merge                     → after integration-test (target/jacoco-merged.exec)
                - report                    → during verify (reads merged exec → target/site/jacoco/jacoco.xml)

              Coverage commands:
                - `./mvnw -pl <module> -am test jacoco:report -P strict-warnings`
                  → unit coverage from default jacoco.exec → target/site/jacoco
                - `./mvnw -pl <module> -am verify -P strict-warnings`
                  → merged unit+IT coverage (modules with *IT under failsafe)

              Kitehub CI (kitehub-ci.yml) runs `mvn test`; pair with `jacoco:report`
              goal to publish per-module coverage (mirrors core-ci.yml pattern).
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <!-- Surefire agent: writes target/jacoco.exec (default) -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- Failsafe agent: writes target/jacoco-it.exec, bound to pre-integration-test -->
                    <execution>
                        <id>prepare-agent-integration</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                            <propertyName>failsafeArgLine</propertyName>
                        </configuration>
                    </execution>

                    <!-- Merge surefire + failsafe execs → target/jacoco-merged.exec -->
                    <execution>
                        <id>merge-results</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>

                    <!-- Generate report from merged exec → target/site/jacoco/jacoco.xml -->
                    <execution>
                        <id>report-merged</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Failsafe: explicitly declare so the prepare-agent-integration argLine
              is wired in. Spring Boot's parent inherits a failsafe binding but does
              NOT wire the JaCoCo argLine — without this, the agent is silently
              dropped and *IT coverage is lost. Bound to integration-test + verify,
              so `mvn test` (kitehub CI default) is unaffected.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>${failsafeArgLine}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      GAP-245 Phase 1 — strict-warnings profile.

      Activated in CI (`mvn -P strict-warnings ...`) so compile output surfaces
      deprecation, unchecked, raw-type, cast, and override warnings prominently.

      Phase 1 (this PR): warnings are SHOWN but build still passes (no -Werror).
      Phase 2 (GAP-261-werror-flipday): inventory + triage existing warnings,
      then flip CI profile to add `-Werror` for fail-on-warning behavior.

      Local dev iteration is unaffected — profile is opt-in via `-P` flag only.
    -->
    <profiles>
        <profile>
            <id>strict-warnings</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <showWarnings>true</showWarnings>
                            <showDeprecation>true</showDeprecation>
                            <compilerArgs>
                                <arg>-Xlint:deprecation</arg>
                                <arg>-Xlint:unchecked</arg>
                                <arg>-Xlint:rawtypes</arg>
                                <arg>-Xlint:cast</arg>
                                <arg>-Xlint:overrides</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
