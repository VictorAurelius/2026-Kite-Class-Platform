# KiteHub Frontend - Docker Environment Variables
# Copy this file to .env.docker and update values

# Node Environment
NODE_ENV=production

# Server Port
PORT=3001

# API Gateway URL — BROWSER-side (host-mapped port). Inlined at build time and
# used by client-side axios.
NEXT_PUBLIC_API_URL=http://gateway:9000

# API Gateway URL — SERVER-side (Docker network DNS). GAP-1444: Server Components
# (e.g. beta-status page) must reach the gateway by its service name, not
# localhost (which resolves to the FE container itself → 404). Local Docker:
# http://kite-gateway:9000 ; production: the internal gateway URL for the deploy.
INTERNAL_API_URL=http://kite-gateway:9000

# KiteClass landing base URL — AI Branding wizard preview iframe (GAP-1215)
# embeds `${NEXT_PUBLIC_KITECLASS_URL}/preview`. Browser-reachable host (not the
# Docker-network name) since the iframe loads in the user's browser.
NEXT_PUBLIC_KITECLASS_URL=http://localhost:3000

# Disable Next.js Telemetry
NEXT_TELEMETRY_DISABLED=1

# Optional: Analytics & Monitoring
# NEXT_PUBLIC_GA_ID=
# SENTRY_DSN=

# Optional: Feature Flags
# NEXT_PUBLIC_ENABLE_AI_BRANDING=true
# NEXT_PUBLIC_ENABLE_PAYMENT=true
