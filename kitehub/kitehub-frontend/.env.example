# KiteHub Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_APP_NAME=KiteHub
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Zalo Official Account ID (13-16 digit) hoặc slug — dùng cho passive CTA support channel.
# Placeholder 'kitehub' khi chưa có OA thật (zalo.me/kitehub sẽ 404 cho tới khi OA active).
# Set giá trị OA ID thật sau khi tạo OA per documents/05-guides/account-prep/zalo-oa-setup-runbook.md
NEXT_PUBLIC_KITEHUB_ZALO_OA_ID=kitehub
