# =============================================================================
# KiteHub Local Development Environment
# =============================================================================
# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# Or run: ./scripts/setup.sh (auto-generates .env with defaults)
# =============================================================================

# --- Database ---
POSTGRES_USER=kitehub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kitehub

# --- RabbitMQ ---
RABBITMQ_USER=kitehub
RABBITMQ_PASSWORD=CHANGE_ME

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=kitehub
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- Security: Encryption Master Key ---
# Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=CHANGE_ME

# --- Security: JWT Secret ---
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# --- AI Provider ---
# Options:
#   "openai" — dùng OpenAI GPT-4 Vision + DALL-E 3 (cần API key thật)
#             Nếu OPENAI_API_KEY=sk-mock-* → mock mode, trả sample response (không cần key)
#   "ollama"  — dùng local LLM (llama3.1:8b text, llava:13b vision), chạy hoàn toàn offline
#             Cần start với: AI_PROVIDER=ollama ./scripts/up.sh --profile ai-local
AI_PROVIDER=openai

# Ollama settings (used when AI_PROVIDER=ollama, start with --profile ai-local)
OLLAMA_BASE_URL=http://kite-ollama:11434
OLLAMA_TEXT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:13b

# OpenAI settings (used when AI_PROVIDER=openai)
# Mock mode: OPENAI_API_KEY=sk-mock-* → returns sample responses, no real API calls
# Real mode: set actual OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-mock-key

# --- KiteClass Tenant URL Pattern ---
# Local: http://localhost:3000?tenant={subdomain}
# Production: https://{subdomain}.kitehub.me
NEXT_PUBLIC_KITECLASS_URL_PATTERN=http://localhost:3000?tenant={subdomain}

# --- KiteClass Core Internal API ---
INTERNAL_API_SECRET=CHANGE_ME

# --- hCaptcha (Anti-spam) ---
# Get keys from: https://dashboard.hcaptcha.com/
# Test keys (always pass): 10000000-ffff-ffff-ffff-000000000001 (site), 0x0000000000000000000000000000000000000000 (secret)
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
CAPTCHA_ENABLED=false

# Frontend hCaptcha site key (for register form)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
