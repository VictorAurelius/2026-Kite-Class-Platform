# =============================================================================
# KiteHub Local Development Environment
# =============================================================================
# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# Or run: ./scripts/setup.sh (auto-generates .env with defaults)
# =============================================================================

# --- Database ---
POSTGRES_USER=kitehub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kitehub

# --- RabbitMQ ---
RABBITMQ_USER=kitehub
RABBITMQ_PASSWORD=CHANGE_ME

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=kitehub
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- Security: Encryption Master Key ---
# Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=CHANGE_ME

# --- Security: JWT Secret ---
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# --- OpenAI (optional - mock mode if not set) ---
OPENAI_API_KEY=sk-mock-key

# --- KiteClass Core Internal API ---
INTERNAL_API_SECRET=CHANGE_ME
